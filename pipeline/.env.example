# ==============================================================================
# RatchetAI Multi-Provider Configuration (Powered by freellm.net Providers)
# ==============================================================================

# Primary LLM Provider: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini

# 1. Google Gemini (Free API Key from https://aistudio.google.com)
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# 2. Groq (100% Free, Ultra-Fast 500+ tok/s from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter Free Tier (Free Models from https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Local Offline Ollama (Zero API Keys Needed - https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Search Tooling Toggle
ENABLE_GOOGLE_SEARCH=false
