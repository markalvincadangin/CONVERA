# ===================================================================
# CONVERA Docker Local Deployment Configuration
# Copy this file to .env before executing `docker compose up`
# ===================================================================

# --- Exposed Service Ports (Dual-Environment Topology: DEPLOYMENT.md) ---
# Host ports 3000 and 8000 are reserved for bare-metal dev (start-dev.sh).
# Production Docker services map to 3001 (Web) and 8001 (FastAPI).
PROD_BACKEND_PORT=8001
PROD_WEB_PORT=3001
BACKEND_PORT=8001
WEB_PORT=3001
OLLAMA_PORT=11434

# --- Security & Progressive Authentication ---
# In Docker deployments, authentication is enabled by default to protect shared instances.
# Set AUTH_ENABLED=false for single-user dev scripts.
AUTH_ENABLED=true

# JWT Secret for access token signing (32+ chars recommended; auto-generated if empty)
JWT_SECRET=

# Symmetric Master Key for Credential Vault (Fernet base64 key; auto-generated at /data/.convera_key if empty)
CONVERA_MASTER_KEY=

# --- Local Sovereign AI Model ---
OLLAMA_MODEL=llama3.2:3b

# --- Cloud AI Providers (Optional Acceleration Layers - Constitution Article VI) ---
# Can be configured here or interactively via the Settings > AI Models UI
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Scholarly Connectors Mailto Headers (Polite Pool Identification) ---
OPENALEX_MAILTO=convera@emaerx.org
CROSSREF_MAILTO=convera@emaerx.org
