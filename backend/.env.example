# ==============================================================================
# CONVERA — Environment Variables Configuration Template
# ==============================================================================
# Product: CONVERA (by EMAERX)
# Standards: CONVERA Concept Development Standard (CCDS) & CIIA v1.0
# Description: Copy this file to `.env` in the root and/or `backend/.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Provider LLM Orchestration Gateway (CIIA Task-Routed Gateway)
# ------------------------------------------------------------------------------
# Active Default Provider: gemini | groq | openrouter | ollama (Default: gemini)
# CONVERA automatically cascades across providers if rate limits (429) or outages occur.
LLM_PROVIDER=gemini

# Primary: Google Gemini (Free API Key from https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Secondary: Groq Cloud (Free Ultra-Fast 500+ tok/s from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: OpenRouter (Free Models from https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Offline: Ollama (100% Local, Private & Free from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. CIIA Research & Scholarly Connectors
# ------------------------------------------------------------------------------
# OpenAlex & Crossref Polite Pool (Identifies your app to scholarly APIs for higher throughput)
OPENALEX_MAILTO=convera@emaerx.org
CROSSREF_MAILTO=convera@emaerx.org

# Semantic Scholar (Optional API Key from https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Web & Discovery Search
ENABLE_GOOGLE_SEARCH=false

# ------------------------------------------------------------------------------
# 3. Methodology & Framework Engine Configuration
# ------------------------------------------------------------------------------
# Default Framework for new sessions: INNOVATION | RESEARCH | CAPSTONE | PRODUCT
DEFAULT_FRAMEWORK_ID=INNOVATION

# ------------------------------------------------------------------------------
# 4. Database & Relational Persistence Subsystem
# ------------------------------------------------------------------------------
# Zero-Ops SQLite WAL Database Path (Default: ./convera.db)
SQLITE_PATH=convera.db

# Optional Cloud PostgreSQL (Neon / Supabase / Render). If left empty, SQLite WAL is used.
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 5. FastAPI Backend Server Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Next.js Web Client Frontend Configuration
# ------------------------------------------------------------------------------
# Backend API Base URL for Next.js (Leave empty to use relative / Next.js rewrites)
NEXT_PUBLIC_API_URL=http://localhost:8000
