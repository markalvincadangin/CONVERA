# ==============================================================================
# RatchetAI Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Provider LLM Orchestration Gateway
# ------------------------------------------------------------------------------
# Active Provider: gemini | groq | openrouter | ollama (Default: gemini)
LLM_PROVIDER=gemini

# Primary: Google Gemini (Free API Key from https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Secondary: Groq Cloud (Free Ultra-Fast 500+ tok/s from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: OpenRouter (Free Models from https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Offline: Ollama (100% Local & Free from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. Database & Persistence Subsystem
# ------------------------------------------------------------------------------
# Optional Cloud PostgreSQL (Neon / Supabase). Leave blank to use SQLite WAL mode.
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Server & Search Features
# ------------------------------------------------------------------------------
ENABLE_GOOGLE_SEARCH=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
