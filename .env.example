# ==============================================================================
# CONVERA — Environment Variables Configuration Template
# ==============================================================================
# Product: CONVERA (by EMAERX)
# Standards: CONVERA Concept Development Standard (CCDS) & CIIA v1.0
# Description: Copy this file to `.env` in the root and/or `backend/.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Provider LLM Orchestration Gateway (CIIA Task-Routed Gateway)
# ------------------------------------------------------------------------------
# Active Default Provider: gemini | groq | openrouter | ollama (Default: gemini)
# CONVERA automatically cascades across providers if rate limits (429) or outages occur.
LLM_PROVIDER=gemini

# Primary: Google Gemini (Free API Key from https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Secondary: Groq Cloud (Free Ultra-Fast 500+ tok/s from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# High-Volume Quota Buffer: Cerebras Cloud (Free 14,400 req/day from https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Free GPT-4o-mini & Llama: GitHub Models (Free Personal Access Token from https://github.com/settings/tokens)
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# Fallback: OpenRouter (Verified Free Models from https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Local Offline: Ollama (100% Local, Private & Free from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. CIIA Research & Scholarly Connectors
# ------------------------------------------------------------------------------
# OpenAlex & Crossref Polite Pool (Identifies your app to scholarly APIs for higher throughput)
OPENALEX_MAILTO=convera@emaerx.org
CROSSREF_MAILTO=convera@emaerx.org

# Semantic Scholar (Optional API Key from https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Web & Discovery Search
ENABLE_GOOGLE_SEARCH=false

# ------------------------------------------------------------------------------
# 3. Methodology & Framework Engine Configuration
# ------------------------------------------------------------------------------
# Default Framework for new sessions: INNOVATION | RESEARCH | CAPSTONE | PRODUCT
DEFAULT_FRAMEWORK_ID=INNOVATION

# ------------------------------------------------------------------------------
# 4. Database & Relational Persistence Subsystem
# ------------------------------------------------------------------------------
# Zero-Ops SQLite WAL Database Path (Default: ./convera.db)
SQLITE_PATH=convera.db

# Optional Cloud PostgreSQL (Neon / Supabase / Render). If left empty, SQLite WAL is used.
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 5. Security, Progressive Authentication & Credential Vault
# ------------------------------------------------------------------------------
# Authentication Gate (false for frictionless local dev; true for team/prod)
AUTH_ENABLED=false

# Secret key for signing JWT session tokens (32+ chars; auto-generated if empty)
JWT_SECRET=

# Fernet symmetric master key for encrypting provider API keys in SQLite (auto-generated if empty)
CONVERA_MASTER_KEY=

# File path storing generated Fernet master key if CONVERA_MASTER_KEY is empty
CONVERA_KEY_PATH=.convera_key

# ------------------------------------------------------------------------------
# 6. FastAPI Backend Server Configuration (Dev & General)
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:3001,http://localhost:8001

# ------------------------------------------------------------------------------
# 7. Next.js Web Client Frontend Configuration
# ------------------------------------------------------------------------------
# Backend API Base URL for Next.js (Leave empty to use relative / Next.js rewrites)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 8. Dual-Environment Production / Docker Topology (DEPLOYMENT.md Profile 3)
# ------------------------------------------------------------------------------
# Host ports 3000 and 8000 remain dedicated to bare-metal development.
# Containerized production maps to ports 3001 (Web) and 8001 (Backend API).
PROD_BACKEND_PORT=8001
PROD_WEB_PORT=3001
PROD_NEXT_PUBLIC_API_URL=
