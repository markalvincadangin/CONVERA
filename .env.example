# ==========================================================
# RatchetAI: Environment Variables Configuration
# ==========================================================

# 1. Primary Free LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. High-Speed Secondary Free LLM Provider (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here

# 3. Fallback Multi-Model Free Provider (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Optional Cloud PostgreSQL Database (Leave blank to use SQLite WAL)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require
